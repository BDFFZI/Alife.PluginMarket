                                                                       "Microsoft.Web.WebView2":  "==1.0.4078.44"
                                                                   }
                                                     },
                                    "dependencies":  {
                                                         "Alife.Function.FunctionCaller":  ""
                                                     },
                                    "note":  "列表只回条数；FeedOpen/FeedReadUrl 只回标题+字数，正文与评论只缓存到面板 articles 目录，不再注入对话；工具文档默认只回一行函数名；UI 增加配色但不改布局。",
                                    "file":  "https://github.com/presents0721/presents.FeedScroll/releases/download/v1.10.2/presents.FeedScroll-1.10.2.zip"
                                }
